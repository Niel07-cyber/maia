# Copy to .env and fill in. Never commit .env.

# LLM providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# Models (LiteLLM format: provider/model). Check these names exist in your dashboards.
LLM_MODEL=gemini/gemini-3.8-flash
LLM_MODEL_ALT=gemini/gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini/gemini-embedding-001

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://maia:maia@db:5432/maia

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173
