# Copy to .env and fill in. Never commit .env.

# LLM providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# Models (LiteLLM format: provider/model). Check these names exist in your dashboards.
LLM_MODEL=openai/gpt-5.4-mini
LLM_MODEL_ALT=openai/gpt-5.4-nano
EMBEDDING_MODEL=openai/text-embedding-3-small

# How long GPT-5 models think: minimal, low, medium or high (empty = provider default)
LLM_REASONING_EFFORT=low

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://maia:maia@db:5432/maia

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173
