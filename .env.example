# Copy to .env and fill in. Never commit .env.

# LLM providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# Models (LiteLLM format: provider/model). Check these names exist in your dashboards.
LLM_MODEL=openai/gpt-4o-mini
LLM_MODEL_ALT=gemini/gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-3-small

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://maia:maia@db:5432/maia

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173
