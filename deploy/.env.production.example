# Copy to .env on the server (next to docker-compose.prod.yml). Never commit it.

# Your address. With an Elastic IP 1.2.3.4, a free option is 1-2-3-4.sslip.io
MAIA_DOMAIN=
POSTGRES_PASSWORD=

OPENAI_API_KEY=
LLM_MODEL=openai/gpt-5.4-mini
LLM_MODEL_ALT=openai/gpt-5.4-nano
